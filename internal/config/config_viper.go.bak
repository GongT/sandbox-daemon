//go:build viper

package config

import (
	"fmt"
	"maps"
	"reflect"
	"slices"
	"strings"

	"github.com/spf13/viper"
	"gitlab.com/tozd/go/errors"
)

type configLoadingContext struct {
	ConfigFillContext

	rv *viper.Viper
}

func (v *configLoadingContext) HasValue(tagPath []string) (bool, error) {
	key := strings.Join(tagPath, ".")
	r := v.rv.IsSet(key)

	for _, tag := range tagPath {
		if containsUppercase(tag) {
			return false, errors.WithStack(fmt.Errorf("配置tag不能包含大写字母: %q", tag))
		}
	}

	return r, nil
}

func containsUppercase(s string) bool {
	for _, r := range s {
		if r >= 'A' && r <= 'Z' { // key不能有英文大写字母
			return true
		}
	}
	return false
}

func (v *configLoadingContext) GetArraySize(tagPath []string) (int, error) {
	key := strings.Join(tagPath, ".")
	if !v.rv.IsSet(key) {
		return 0, errors.WithStack(fmt.Errorf("错误调用GetArraySize: 路径不存在"))
	}
	data := v.rv.Get(key)
	typ := reflect.TypeOf(data)
	if typ.Kind() != reflect.Slice && typ.Kind() != reflect.Array {
		return 1, nil
	}
	return reflect.ValueOf(data).Len(), nil
}

func (v *configLoadingContext) GetObjectKeys(tagPath []string) ([]string, error) {
	key := strings.Join(tagPath, ".")
	if !v.rv.IsSet(key) {
		return nil, errors.WithStack(fmt.Errorf("错误调用GetObjectKeys: 路径不存在"))
	}
	data := v.rv.GetStringMapString(key)
	list := slices.Collect(maps.Keys(data))

	if len(list) == 0 {
		if v.rv.GetString(key) != "" {
			return nil, errors.WithStack(fmt.Errorf("错误调用GetObjectKeys: 路径不是对象"))
		}
	}

	return list, nil
}

func (v *configLoadingContext) GetValue(t reflect.Type, tagPath []string) (string, error) {
	key := strings.Join(tagPath, ".")
	if !v.rv.IsSet(key) {
		return "", errors.WithStack(fmt.Errorf("错误调用GetValue: 路径不存在"))
	}
	return v.rv.GetString(key), nil
}
